APP_NAME="Chain Space"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://api.example.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chain_space_1
DB_USERNAME=chain_space_1
DB_PASSWORD=change_me
DB_PREFIX=cs_
DB_MIGRATIONS_TABLE=migrations

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=oss

# 队列模式二选一:
# 1. 保持当前生产链路: QUEUE_CONNECTION=rabbitmq
# 2. 切换到 Horizon: QUEUE_CONNECTION=redis
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis
CACHE_PREFIX=prod:chain-space-1:cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default

# Horizon 配置
HORIZON_QUEUE_CONNECTION=redis
HORIZON_DEFAULT_QUEUE=default
HORIZON_VIDEO_QUEUE=video-processing
HORIZON_BALANCE=auto
HORIZON_DEFAULT_MAX_PROCESSES=10
HORIZON_VIDEO_MAX_PROCESSES=2
HORIZON_DEFAULT_TRIES=3
HORIZON_VIDEO_TRIES=3
HORIZON_DEFAULT_TIMEOUT=120
HORIZON_VIDEO_TIMEOUT=900
HORIZON_ALLOWED_EMAILS=ops@example.com
HORIZON_NOTIFICATION_EMAIL=
HORIZON_NOTIFICATION_SLACK_WEBHOOK=
HORIZON_PATH=horizon

# RabbitMQ 配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=chain-space-1
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/chain-space-1
RABBITMQ_QUEUE=chain-space-1.default
RABBITMQ_EXCHANGE_NAME=chain-space-1.topic
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_RETRY_AFTER=90

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=cn-shanghai
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ROOT=
OSS_REGION=cn-shanghai
OSS_IS_CNAME=false
OSS_SIGNATURE_VERSION=v4
OSS_CDN_URL=

CARD_ASSETS_DISK=oss

VIDEO_PROCESSING_FFMPEG_BINARY=/usr/bin/ffmpeg
VIDEO_PROCESSING_FFMPEG_TIMEOUT=600
VIDEO_PROCESSING_WORKDIR=/var/www/chain-space-1/shared/storage/app/video-processing
VIDEO_PROCESSING_QUEUE_CONNECTION=${QUEUE_CONNECTION}
VIDEO_PROCESSING_QUEUE=video-processing
VIDEO_PROCESSING_SOURCE_PREFIX=card-assets/source
VIDEO_PROCESSING_PLAYBACK_DISK=oss
VIDEO_PROCESSING_PLAYBACK_PREFIX=card-assets/playback
VIDEO_PROCESSING_TEMP_PREFIX=card-assets/tmp
VIDEO_PROCESSING_PLAYBACK_URL=
VIDEO_PROCESSING_CDN_DOMAIN=
VIDEO_PROCESSING_CDN_CACHE_TTL_SECONDS=86400
VIDEO_PROCESSING_CDN_PRIVATE_CACHE_TTL_SECONDS=600
VIDEO_PROCESSING_CDN_ANTI_LEECH_ENABLED=true
VIDEO_PROCESSING_CDN_ALLOWED_REFERERS=example.com,www.example.com
VIDEO_PROCESSING_SOURCE_RETENTION_DAYS=30
VIDEO_PROCESSING_PLAYBACK_RETENTION_DAYS=365
VIDEO_PROCESSING_TEMP_RETENTION_DAYS=3
VIDEO_PROCESSING_UPLOAD_MAX_ATTEMPTS=3
VIDEO_PROCESSING_HEALTHCHECK_COMMAND="/usr/bin/ffmpeg -version"
VIDEO_PROCESSING_WORKER_COMMAND="php artisan queue:work rabbitmq --queue=video-processing --tries=3 --backoff=10"
VIDEO_PROCESSING_DEPLOY_COMMAND="php artisan migrate --force && php artisan config:cache && php artisan queue:restart"
VIDEO_PROCESSING_ROLLBACK_COMMAND="php artisan migrate:rollback --step=1 && php artisan queue:restart"

AUDIT_ENABLE=true
AUDIT_APPLY_MEDIA_TYPES=file
AUDIT_BYPASS_ENVIRONMENTS=local,testing
AUDIT_TIMEOUT_SECONDS=300
AUDIT_MAX_RETRIES=3
AUDIT_RETRY_BACKOFF_SECONDS=30,120,300
AUDIT_QUARANTINE_RETENTION_DAYS=7
AUDIT_DEFAULT_ENGINE=aliyun_guardrail_v1
AUDIT_STUB_DECISION=passed
AUDIT_TEMPORARY_PREFIX=tmp/cards/files
AUDIT_FORMAL_PREFIX=cards/files
AUDIT_QUARANTINE_PREFIX=quarantine/cards/files

ALIYUN_GUARDRAIL_ENDPOINT=
ALIYUN_GUARDRAIL_REGION=cn-shanghai
ALIYUN_GUARDRAIL_ACCESS_KEY_ID=
ALIYUN_GUARDRAIL_ACCESS_KEY_SECRET=
ALIYUN_GUARDRAIL_MOCK=false
ALIYUN_GUARDRAIL_HTTP_TIMEOUT=5
ALIYUN_GUARDRAIL_HTTP_RETRY=true

ADMIN_UPLOAD_DISK=oss
ADMIN_UPLOAD_IMAGE_DIRECTORY=admin/images
ADMIN_UPLOAD_FILE_DIRECTORY=admin/files
ADMIN_WITHDRAWAL_ROLE_SLUGS=operations

ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=prod_chain_space_1
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

IMAGE_DRIVER=gd

WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_APP_TOKEN=
WECHAT_MINI_APP_AES_KEY=
WECHAT_MINI_APP_USE_STABLE_ACCESS_TOKEN=false
WECHAT_HTTP_TIMEOUT=5
WECHAT_HTTP_RETRY=true

WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERTIFICATE_PATH=
WECHAT_PAY_SECRET_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
WECHAT_PAY_HTTP_TIMEOUT=5

MOCK_PAYMENT_CALLBACK_TOKEN=disabled-in-production
MOCK_WITHDRAWAL_CALLBACK_TOKEN=disabled-in-production

VITE_APP_NAME="${APP_NAME}"
