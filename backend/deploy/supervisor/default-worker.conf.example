[program:chain-space-default-worker]
command={{php_bin}} {{app_root}}/artisan queue:work {{queue_connection}} --queue={{queue_name}} --tries=3 --backoff=10 --sleep=3 --timeout=120 --max-time=3600
directory={{app_root}}
process_name=%(program_name)s_%(process_num)02d
numprocs=2
autostart=true
autorestart=true
startsecs=5
startretries=3
stopwaitsecs=180
stopsignal=QUIT
stopasgroup=true
killasgroup=true
user={{app_user}}
redirect_stderr=true
stdout_logfile={{stdout_logfile}}
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
environment=APP_ENV="{{app_env}}",QUEUE_CONNECTION="{{queue_connection}}",RABBITMQ_QUEUE="{{queue_name}}"
